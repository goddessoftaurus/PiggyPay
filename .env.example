# Copy to .env and fill in. Never commit real keys.

PORT=3000
ADMIN_PASSWORD=change-me

# Public URL fallback for Stripe success/cancel if a request has no Host
# header. When a visitor hits this service, the request host is used instead,
# so two Render services can share this code without pointing at each other.
# Example: https://your-app.onrender.com
PUBLIC_URL=

# Optional. If set (e.g. wheel.html), GET / redirects to /wheel.html and keeps
# the query string. Leave blank to serve the links page at /.
# ROOT_PAGE=wheel.html

# Stripe — leave blank to hide "Pay by card". Use test keys (sk_test_...) first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres for durable storage (recommended when hosting, e.g. a free Neon database:
# https://neon.tech). Leave blank to store data in server/data/db.json instead,
# which free hosts like Render erase on every restart.
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
